        <mxCell id="frame3" value="&lt;b&gt;【3. MAVLink #100 (OPTICAL_FLOW) の二重送信 (StampFly FC ＆ GCS)】&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=280;height=26;fillColor=#fffbf0;strokeColor=#fd7e14;fontColor=#856404;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1">
          
          
          <mxGeometry x="200" y="770" width="1580" height="220" as="geometry"/>
          
        
