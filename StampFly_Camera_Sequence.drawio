        <mxCell id="sub_frame_b" value="&lt;b&gt;【ルートB: 静止画フレーム取り込み ＆ オプティカルフロー演算】&lt;/b&gt;" style="shape=umlFrame;whiteSpace=wrap;html=1;width=280;height=26;fillColor=#f0fff4;strokeColor=#28a745;fontColor=#155724;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1">
          
          
