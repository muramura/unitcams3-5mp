              <mxPoint x="1740" y="880"/>
              
            
            </Array>
            
          
          </mxGeometry>
          
        
        </mxCell>
        
        
        <mxCell id="m16" value="16. Wi-Fi UDP 14550 送信 (ブロードキャスト / ユニキャスト) ➔ MAVLink #100" style="html=1;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;fontColor=#222;fontSize=11;strokeWidth=1.5;strokeColor=#007bff;strokeWidth=2;;endArrow=block;;labelBackgroundColor=#ffffff;labelBorderColor=none;" edge="1" parent="1">
          
          
          <mxGeometry relative="1" as="geometry">
            
            
