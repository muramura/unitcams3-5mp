            <mxPoint x="1690" y="815" as="targetPoint"/>
            
          
          </mxGeometry>
          
        
        </mxCell>
        
        
        <mxCell id="m15" value="15. ArduPilot EKF3 がオプティカルフロー速度を積分&#10;    水平ドリフトを相殺し、高精度自律ホバリング制御" style="html=1;align=left;spacingLeft=5;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;curved=0;rounded=0;endArrow=block;fontColor=#333;fontSize=11;strokeWidth=1.5;strokeColor=#d9534f;strokeWidth=2;;labelBackgroundColor=#ffffff;labelBorderColor=none;" edge="1" parent="1">
          
          
