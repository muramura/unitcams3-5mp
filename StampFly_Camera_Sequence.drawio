        </mxCell>
        
        
        <mxCell id="note_box" value="&lt;b&gt;【核心設計ハイライト】&lt;/b&gt;&lt;br/&gt;① &lt;b&gt;ゼロコピー並列化&lt;/b&gt;: 単一の &lt;code&gt;camera_fb_t *fb&lt;/code&gt; を HTTP送信タスクとフロー演算タスクが共有参照。&lt;br/&gt;② &lt;b&gt;Core0 / Core1 分離&lt;/b&gt;: 負荷の高い画像処理・Wi-Fi動画送信を &lt;b&gt;Core 0&lt;/b&gt;、超低遅延が要求されるMAVLink UARTルーターを &lt;b&gt;Core 1&lt;/b&gt; に完全分離。" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=10;fillColor=#fff9c4;strokeColor=#fbc02d;fontColor=#444;fontSize=11;" vertex="1" parent="1">
          
          
          <mxGeometry x="40" y="1010" width="1050" height="60" as="geometry"/>
          
        
        </mxCell>
        
      
