        <mxCell id="title" value="&lt;h2 style=&quot;margin:0;color:#003366;&quot;&gt;🚁 StampFly Companion (CamS3-5MP) カメラ画像配信・オプティカルフロー 並列シーケンス図&lt;/h2&gt;&lt;p style=&quot;margin:4px 0 0 0;font-size:12px;color:#555;&quot;&gt;単一のPY260カメラセンサーから【動画像ストリーム(Wi-Fi HTTP)】と【静止画オプティカルフロー(MAVLink #100)】をゼロコピー並列処理&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          
          
          <mxGeometry x="40" y="15" width="1200" height="40" as="geometry"/>
          
        
        </mxCell>
        
        
